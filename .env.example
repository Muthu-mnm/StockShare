# =================================================================
# StockShare Environment Configuration Reference
# Copy this file to .env for local adjustments.
# Do NOT commit production secrets or password credentials to Git.
# =================================================================

# Backend Configuration
PORT=5000
DATA_DIR=/app/data
# Optional custom SQLite database path override:
# DB_PATH=/app/data/stockshare.db

# Frontend Configuration
# Leave blank for local proxy (/api) and Docker Nginx reverse proxy
VITE_API_BASE_URL=

# Monitoring & Security
# Change this in production environments
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Compose Configuration
COMPOSE_PROJECT_NAME=stockshare
